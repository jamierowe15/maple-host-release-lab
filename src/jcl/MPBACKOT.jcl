//MPBACKOT JOB 1,NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* BACKOUT: RESTORE THE STAGE LIBRARY FROM ITS PRE-CHANGE BACKUP
//* (TAKEN BY MPPROMOT STEP BACKUP).  USE ONLY UNDER THE CHANGE
//* RECORD'S BACKOUT PLAN, THEN RERUN PAT TO PROVE THE RESTORE.
//*-------------------------------------------------------------------
//         SET TO=PROD
//RESTORE  EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//INSRC    DD DSN=&SYSUID..MPL.BKUP&TO..SRC,DISP=SHR
//OUTSRC   DD DSN=&SYSUID..MPL.&TO..SRC,DISP=SHR
//INLOAD   DD DSN=&SYSUID..MPL.BKUP&TO..LOAD,DISP=SHR
//OUTLOAD  DD DSN=&SYSUID..MPL.&TO..LOAD,DISP=SHR
//SYSIN    DD *
  COPY INDD=((INSRC,R)),OUTDD=OUTSRC
  COPY INDD=((INLOAD,R)),OUTDD=OUTLOAD
/*
