//MPPROMOT JOB 1,NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* PROMOTION (ENDEVOR-STYLE MOVE):  FROM -> TO
//*   DEV -> QA    AFTER BUILD + UNIT CHECK
//*   QA  -> PROD  ONLY INSIDE AN APPROVED CHANGE WINDOW
//* STEP BACKUP  SAVES THE CURRENT TARGET INTO MPL.BKUP<TO>.* SO
//*              MPBACKOT CAN RESTORE IT (BACKOUT PLAN).
//* STEP PROMOTE COPIES SOURCE AND LOAD MODULE, REPLACING MEMBERS.
//* FIRST PROMOTION TO AN EMPTY LIBRARY MAY GIVE BACKUP RC=4: OK.
//*-------------------------------------------------------------------
//         SET FROM=DEV
//         SET TO=QA
//BACKUP   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//INSRC    DD DSN=&SYSUID..MPL.&TO..SRC,DISP=SHR
//OUTSRC   DD DSN=&SYSUID..MPL.BKUP&TO..SRC,DISP=SHR
//INLOAD   DD DSN=&SYSUID..MPL.&TO..LOAD,DISP=SHR
//OUTLOAD  DD DSN=&SYSUID..MPL.BKUP&TO..LOAD,DISP=SHR
//SYSIN    DD *
  COPY INDD=((INSRC,R)),OUTDD=OUTSRC
  COPY INDD=((INLOAD,R)),OUTDD=OUTLOAD
/*
//         IF (BACKUP.RC <= 4) THEN
//PROMOTE  EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//INSRC    DD DSN=&SYSUID..MPL.&FROM..SRC,DISP=SHR
//OUTSRC   DD DSN=&SYSUID..MPL.&TO..SRC,DISP=SHR
//INLOAD   DD DSN=&SYSUID..MPL.&FROM..LOAD,DISP=SHR
//OUTLOAD  DD DSN=&SYSUID..MPL.&TO..LOAD,DISP=SHR
//SYSIN    DD *
  COPY INDD=((INSRC,R)),OUTDD=OUTSRC
  COPY INDD=((INLOAD,R)),OUTDD=OUTLOAD
/*
//         ENDIF
