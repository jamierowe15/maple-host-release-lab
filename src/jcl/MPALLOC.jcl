//MPALLOC  JOB 1,NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* MAPLE HOST RELEASE LAB - ONE-TIME ALLOCATION (DAY 1)
//* CREATES THE STAGE LIBRARIES (DEV / QA / PROD), THE BACKOUT
//* LIBRARIES AND A JCL LIBRARY UNDER YOUR OWN HIGH-LEVEL QUALIFIER.
//* RUN ONCE.  A RERUN FAILS WITH "DUPLICATE NAME" - THAT IS EXPECTED.
//*-------------------------------------------------------------------
//ALLOC    EXEC PGM=IEFBR14
//JCL      DD DSN=&SYSUID..MPL.JCL,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=FB,LRECL=80
//DEVSRC   DD DSN=&SYSUID..MPL.DEV.SRC,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=FB,LRECL=80
//QASRC    DD DSN=&SYSUID..MPL.QA.SRC,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=FB,LRECL=80
//PRODSRC  DD DSN=&SYSUID..MPL.PROD.SRC,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=FB,LRECL=80
//BKQASRC  DD DSN=&SYSUID..MPL.BKUPQA.SRC,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=FB,LRECL=80
//BKPRSRC  DD DSN=&SYSUID..MPL.BKUPPROD.SRC,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=FB,LRECL=80
//DEVLOAD  DD DSN=&SYSUID..MPL.DEV.LOAD,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=U,BLKSIZE=32760
//QALOAD   DD DSN=&SYSUID..MPL.QA.LOAD,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=U,BLKSIZE=32760
//PRODLOAD DD DSN=&SYSUID..MPL.PROD.LOAD,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=U,BLKSIZE=32760
//BKQALOAD DD DSN=&SYSUID..MPL.BKUPQA.LOAD,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=U,BLKSIZE=32760
//BKPRLOAD DD DSN=&SYSUID..MPL.BKUPPROD.LOAD,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,10)),DSNTYPE=LIBRARY,
//            RECFM=U,BLKSIZE=32760
