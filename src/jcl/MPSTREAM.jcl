//MPSTREAM JOB 1,NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* NIGHTLY INTEREST ACCRUAL BATCH STREAM
//*   ENV  = WHICH LOAD LIBRARY RUNS THE PROGRAM: DEV, QA OR PROD
//*   DATA = WHICH INPUT IS PROCESSED:            TEST OR PROD
//* STEP010 CLEANUP -> STEP020 SORT -> STEP030 MPINTCLC -> STEP040/045
//* PRINT.  RC=4 FROM STEP030 MEANS REJECTS WERE WRITTEN (NOT A FAIL).
//* RESTART: SEE MPRESTRT.JCL AND /scheduling/CA11-RESTART-RUNBOOK.md
//*-------------------------------------------------------------------
//         SET ENV=DEV
//         SET DATA=TEST
//*
//STEP010  EXEC PGM=IEFBR14
//SORTED   DD DSN=&SYSUID..MPL.&DATA..SORTED,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//RPT      DD DSN=&SYSUID..MPL.&DATA..RPT,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//REJ      DD DSN=&SYSUID..MPL.&DATA..REJ,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1))
//*
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..MPL.&DATA..ACCTIN,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..MPL.&DATA..SORTED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
/*
//*
//         IF (STEP020.RC = 0) THEN
//STEP030  EXEC PGM=MPINTCLC
//STEPLIB  DD DSN=&SYSUID..MPL.&ENV..LOAD,DISP=SHR
//ACCTIN   DD DSN=&SYSUID..MPL.&DATA..SORTED,DISP=SHR
//RPTOUT   DD DSN=&SYSUID..MPL.&DATA..RPT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//REJOUT   DD DSN=&SYSUID..MPL.&DATA..REJ,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//SYSOUT   DD SYSOUT=*
//         ENDIF
//*
//         IF (STEP030.RC <= 4) THEN
//STEP040  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=&SYSUID..MPL.&DATA..RPT,DISP=SHR
//SYSUT2   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//STEP045  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=&SYSUID..MPL.&DATA..REJ,DISP=SHR
//SYSUT2   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//*
//* DAY 3 - JOB TRIGGER (CA 7 STYLE).  UNCOMMENT THE 4 LINES BELOW
//* AFTER MPPATCMP IS STORED IN YOUR MPL.JCL LIBRARY.  ON SUCCESS
//* THIS JOB SUBMITS THE PAT COMPARE JOB THROUGH THE INTERNAL READER.
//*STEP050 EXEC PGM=IEBGENER
//*SYSUT1  DD DSN=&SYSUID..MPL.JCL(MPPATCMP),DISP=SHR
//*SYSUT2  DD SYSOUT=(A,INTRDR)
//*SYSPRINT DD DUMMY
//         ENDIF
