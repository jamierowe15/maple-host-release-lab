//MPPATCMP JOB 1,NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* PAT CHECK: COMPARE THE ACTUAL REPORT WITH THE SIGNED-OFF EXPECTED
//* RESULT USING SUPERC.   RC=0  -> NO DIFFERENCES = PAT PASS
//*                        RC=1  -> DIFFERENCES    = PAT FAIL
//*   ACTUAL = TEST OR PROD   (WHICH RUN TO CHECK)
//*   EXPECT = V10TEST | V11TEST | V11PROD   (WHICH BASELINE)
//* SAVE THE JOB OUTPUT AS EVIDENCE FOR THE CHANGE RECORD.
//*-------------------------------------------------------------------
//         SET ACTUAL=TEST
//         SET EXPECT=V10TEST
//COMPARE  EXEC PGM=ISRSUPC,PARM=(DELTAL,LINECMP,'','')
//NEWDD    DD DSN=&SYSUID..MPL.&ACTUAL..RPT,DISP=SHR
//OLDDD    DD DSN=&SYSUID..MPL.EXP.&EXPECT,DISP=SHR
//OUTDD    DD SYSOUT=*
